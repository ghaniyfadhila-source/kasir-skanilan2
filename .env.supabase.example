# ==============================================================================
# Konfigurasi Supabase — Salin nilai dari Supabase Dashboard > Project Settings > API
#
# CARA MENGISI:
#   1. Buka https://supabase.com/dashboard > project kasir-skanilan2 > Settings > API
#   2. Salin Project URL, anon key, dan service_role key
#   3. Isi SUPABASE_SERVICE_ROLE_KEY LANGSUNG di file ini (jangan pernah commit)
#
# Format connection string PostgreSQL:
#   postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DB_NAME]
# Contoh:
#   postgresql://postgres:password-kamu@db.abcdefg.supabase.co:5432/postgres
# ==============================================================================

# --- Koneksi database (Laravel eloquent) ---------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db.XXXXXXXXXXXX.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=ganti-dengan-password-database-kamu

# --- Supabase API -------------------------------------------------------------
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co

# Anon key: aman untuk frontend (Cashier Web UI / Admin Dashboard).
SUPABASE_ANON_KEY=ganti-dengan-anon-key

# ⚠️ JANGAN PERNAH commit nilai di bawah. Key ini memberi akses penuh ke database.
#    Pakai hanya di backend untuk broadcast Realtime dan signed URL Storage.
SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-service-role-key

# --- Realtime (Ticket 09) ------------------------------------------------------
# Channel yang dipakai:
#   console:{device_id}   backend <-> ESP8266
#   cashier:{device_id}   backend -> Cashier Web UI
#   admin:dashboard       backend -> semua browser admin
SUPABASE_REALTIME_ENABLED=true

# --- Storage (Ticket 14 - OTA) -------------------------------------------------
SUPABASE_STORAGE_BUCKET=firmware
# Umbrella bucket untuk firmware ESP8266. Firmware TIDAK disimpan di repo,
# selalu lewat Storage Supabase supaya bisa di-rollback.
SUPABASE_STORAGE_PUBLIC=false