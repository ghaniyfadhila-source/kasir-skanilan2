# ==============================================================================
# Konfigurasi Supabase - contoh. Salin nilainya dari Supabase Dashboard.
#
# File ini HANYA berisi placeholder dan aman untuk di-commit.
# Nilai aslinya ditulis ke `.env` yang sudah masuk .gitignore.
#
# CARA PENGISIAN YANG DISARANKAN:
#
#   1. Buat project di Supabase. Pilih region yang benar, karena region tidak
#      bisa diubah setelah project dibuat.
#   2. Salin connection string:
#        Dashboard > Database > Connection > tab "Session Pooler" > URI
#   3. Tulis ke .env dengan perintah (menangani password khusus secara benar):
#
#        php artisan supabase:configure --uri="postgresql://..."
#
#      atau kalau lebih suka mengetik sendiri:
#
#        php artisan supabase:configure \
#            --url=https://<ref>.supabase.co \
#            --region=ap-southeast-1 \
#            --password="<password>"
#
#   4. Salin kunci API dari Dashboard > Project Settings > API, lalu tempel
#      ke bagian paling bawah file ini secara manual.
#   5. Periksa semuanya:
#
#        php artisan supabase:check
# ==============================================================================


# --- Koneksi database ----------------------------------------------------------
#
# Block ini dibaca oleh koneksi `supabase` di config/database.php.
# Mengaktifkannya cukup dengan DB_CONNECTION=supabase di .env.
#
# Jangan memakai nama variabel DB_* di sini: blok itu dipakai koneksi utama,
# yang sengaja tetap SQLite untuk pengembangan lokal.
#
# Cara mengisi nilai-nilai ini: `php artisan supabase:configure`.
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=postgres.ganti-dengan-project-ref
SUPABASE_DB_PASSWORD=ganti-dengan-password-database

# PENTING: password yang diawali "#" WAJIB diapit tanda kutip di .env.
# Tanpa tanda kutip, phpdotenv menganggapnya sebagai awal komentar dan
# nilainya jadi kosong tanpa pesan error.
#   DB_PASSWORD="#password-awal-nya-hash"


# --- Kunci API -----------------------------------------------------------------
#
# Tempel nilainya di .env, bukan di file contoh ini.
#
# Dua format yang dipakai Supabase saat ini:
#
#   Format lama (JWT)      : dipisah antara "anon key" dan "service_role key"
#   Format baru (Supabase) : sb_publishable_... (untuk browser)
#                            sb_secret_...      (pengganti service_role)
#
# `php artisan supabase:check` menguji keduanya dan memberi tahu mana yang
# ditolak, jadi tidak perlu menebak format mana yang dipakai project kamu.
SUPABASE_URL=https://ganti-dengan-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=


# --- Realtime (Ticket 09) ------------------------------------------------------
#
# Channel yang dipakai:
#   console:{device_id}   backend  <-> ESP8266
#   cashier:{device_id}   backend  -> Cashier Web UI
#   admin:dashboard       backend  -> semua browser admin
#
# Kunci untuk sisi browser (anon/publishable) dan sisi server (service_role/
# secret) keduanya wajib ada. `supabase:check` akan memperingatkan kalau salah
# satu kelompok belum terisi.
SUPABASE_REALTIME_ENABLED=true


# --- Storage (Ticket 14 - OTA) -------------------------------------------------
#
# Bucket firmware ESP8266. Firmware tidak disimpan di repo, selalu lewat Storage
# Supabase supaya bisa di-rollback kalau rilis baru rusak.
SUPABASE_STORAGE_BUCKET=firmware
# WAJIB false. Firmware hanya boleh diambil lewat signed URL berumur pendek.
SUPABASE_STORAGE_PUBLIC=false


# --- Verification (Ticket 15) --------------------------------------------------
# Deskripsi EXPECTED_SOFTWARE_VERSION ditulis firmware, dibaca firmware lain saat
# boot supaya tahu harus OTA atau tidak.
EXPECTED_SOFTWARE_VERSION=1.0.0